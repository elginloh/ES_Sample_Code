    {
        "id": "csc14_http_fn",
        "type": "function",
        "z": "csc14_tab",
        "name": "health JSON",
        "func": "// GET /csc14/health -> 200 when broker and database are reachable, else 503\nconst h = global.get('csc14').health();\nmsg.payload = h;\nmsg.statusCode = h.ok ? 200 : 503;\nmsg.headers = { 'content-type': 'application/json' };\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
