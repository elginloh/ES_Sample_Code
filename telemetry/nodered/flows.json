    {
        "id": "csc14_health",
        "type": "function",
        "z": "csc14_tab",
        "name": "pipeline health",
        "func": "// Pipeline health (backend, not robot): buffer, database, broker,\n// write latency, memory.  Stored every 10 s in csc14.ingest_health.\nmsg.ops = global.get('csc14').healthOps();\nconst h = msg.ops[0].row;\nnode.status({ fill: (h.db_connected === false || h.broker_connected === false) ? 'red' : 'green',\n\tshape: 'dot', text: 'p95 ' + (h.latency_p95_ms === null ? '-' : h.latency_p95_ms) + ' ms, ' +\n\t(h.queue_bulk + h.queue_priority) + ' queued, ' + h.rss_mb + ' MB' });\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 500,
        "wires": [
            [
                "csc14_store"
            ]
        ]
    },
