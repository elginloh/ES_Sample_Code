    {
        "id": "csc14_decode",
        "type": "function",
        "z": "csc14_tab",
        "name": "validate, decode, route",
        "func": "// Every robot frame arrives as a Buffer (mqtt in: output \"a Buffer\").\n// api.ingest() checks length, CRC, version, type and the range of every\n// field, interprets the frame and returns the database operations\n// (telemetry/lib/ingest.js).  Malformed frames only produce a\n// rejected_frame row; they never reach the measurement tables.\nconst api = global.get('csc14');\nconst r = api.ingest(msg.topic, msg.payload, Date.now());\nmsg.kind = r.kind;\nmsg.ops = r.ops;\nmsg.payload = r.decoded || { rejected: r.reason || r.kind, detail: r.detail || null };\nconst order = ['telemetry', 'heartbeat', 'event', 'ack', 'rejected'];\nconst out = [null, null, null, null, null, null];\nconst i = order.indexOf(r.kind);\nout[i < 0 ? 5 : i] = msg;\nconst st = api.stats().ingest;\nnode.status({ fill: st.rejected ? 'yellow' : 'green', shape: 'dot',\n\ttext: st.frames + ' frames, ' + st.rejected + ' rejected' });\nreturn out;\n",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "// Node-RED stop or re-deploy: flush, save state\nreturn global.get('csc14').shutdown();\n",
        "libs": [],
        "x": 420,
        "y": 130,
        "wires": [
            [
                "csc14_store",
                "csc14_dbg_tlm"
            ],
            [
                "csc14_store"
            ],
            [
                "csc14_store",
                "csc14_dbg_evt"
            ],
            [
                "csc14_store",
                "csc14_dbg_ack"
            ],
            [
                "csc14_store",
                "csc14_dbg_rej"
            ],
            [
                "csc14_store"
            ]
        ],
        "outputLabels": [
            "telemetry",
            "heartbeat",
            "event",
            "ack",
            "rejected",
            "other"
        ]
    },
    {
        "id": "csc14_store",
        "type": "function",
        "z": "csc14_tab",
        "name": "store in PostgreSQL",
        "func": "// Rows -> bounded in-memory queue -> PostgreSQL (telemetry/lib/store.js):\n// parameterized INSERTs, retried with back-off while the database is\n// unavailable; only a full buffer drops rows (oldest first, counted).\nconst api = global.get('csc14');\nif (msg.ops && msg.ops.length) {\n\tapi.store(msg.ops);\n}\nconst st = api.stats();\nnode.status({ fill: st.db === false ? 'red' : (st.db ? 'green' : 'grey'),\n\tshape: st.db ? 'dot' : 'ring',\n\ttext: (st.db === false ? 'database unavailable, ' : 'database ok, ') + st.queued + ' queued' });\nreturn null;\n",
        "outputs": 0,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 130,
        "wires": []
    },
