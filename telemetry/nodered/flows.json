    {
        "id": "csc14_broker_fn",
        "type": "function",
        "z": "csc14_tab",
        "name": "backend <-> broker",
        "func": "// The mqtt in nodes report node-red:common.status.connected /\n// .disconnected / .connecting.  Losing the broker makes the robot's link\n// state UNKNOWN (a backend problem), not OFFLINE.\nconst text = (msg.status && msg.status.text) || '';\nif (!/\\.(connected|disconnected)$/.test(text)) {\n\treturn null;\n}\nmsg.ops = global.get('csc14').brokerStatus(/\\.connected$/.test(text));\nreturn msg.ops.length ? msg : null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 620,
        "wires": [
            [
                "csc14_store"
            ]
        ]
    },
