    {
        "id": "csc14_link",
        "type": "function",
        "z": "csc14_tab",
        "name": "online / stale / offline",
        "func": "// Online / stale / offline from the age of the last heartbeat or\n// telemetry frame (CSC14_STALE_AFTER_S, CSC14_OFFLINE_AFTER_S).\nmsg.ops = global.get('csc14').tick(Date.now());\nreturn msg.ops.length ? msg : null;\n",
