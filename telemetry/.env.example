# CSC14 telemetry backend configuration.
# "bin/csc14 setup" copies this file to .env (never committed) and fills in
# random passwords.  Edit .env, not this file.

# --- Robot and MQTT -------------------------------------------------------
# Name stored with every record (the binary protocol has no robot id).
CSC14_ROBOT_ID=csc14-car
# Broker Node-RED subscribes to.  127.0.0.1 = the broker on this computer,
# i.e. the same Mosquitto the Pico publishes to (config/wifi_secrets.h has
# this computer's Wi-Fi address).  Node-RED runs natively, so 127.0.0.1 is
# correct here; it would NOT be inside a container.
CSC14_MQTT_HOST=127.0.0.1
CSC14_MQTT_PORT=1883
CSC14_MQTT_CLIENT_ID=csc14-nodered
# Topic prefixes.  Live robot frames: csc14/tlm, csc14/hb, csc14/evt,
# csc14/ack.  Simulated frames (tools/simulate.js) use sim/csc14/... and are
# stored with source = 'simulated', never inside a live run.
CSC14_TOPIC_LIVE=csc14
CSC14_TOPIC_SIM=sim/csc14
# Started by "bin/csc14 start" ONLY when nothing answers on the broker port.
# Leave empty to never start a broker (e.g. when Mosquitto is a system service).
CSC14_BROKER_CONF=

# --- How the flashed firmware was built (changes interpretation) ---------
# drv_ir.h IR_SIDES_MIRRORED: 1 = GP27 sensor on the car's LEFT (default)
CSC14_IR_SIDES_MIRRORED=1
# sys_state_logic.c team decision flags (all 1 by default)
CSC14_SYS_COLLISION_STOPS=1
CSC14_SYS_IMU_REQUIRED=1
CSC14_SYS_US_REQUIRED=1

# --- Robot link thresholds (heartbeat every 1 s) --------------------------
CSC14_STALE_AFTER_S=3
CSC14_OFFLINE_AFTER_S=10

# --- PostgreSQL -----------------------------------------------------------
CSC14_PG_HOST=127.0.0.1
CSC14_PG_PORT=5432
CSC14_PG_DATABASE=csc14_telemetry
# Account used only by "setup"/"migrate" to create the database and roles.
# Homebrew: your macOS user (empty = current user).  Raspberry Pi: postgres.
CSC14_PG_ADMIN_USER=
CSC14_PG_ADMIN_PASSWORD=
# Node-RED writes with this role, Grafana reads with the other.
CSC14_PG_WRITER_USER=csc14_writer
CSC14_PG_WRITER_PASSWORD=
CSC14_PG_READER_USER=csc14_reader
CSC14_PG_READER_PASSWORD=
# Homebrew cluster "bin/csc14 start" may start with pg_ctl if it is down
# (empty = never start PostgreSQL).
CSC14_PG_DATA=

# --- Node-RED ingestion ---------------------------------------------------
CSC14_NODERED_HOST=127.0.0.1
CSC14_NODERED_PORT=1880
CSC14_NODERED_CREDENTIAL_SECRET=
# Rows held in memory while PostgreSQL is unreachable.  Telemetry and
# heartbeats (3 rows/s) share the bulk buffer: 10800 rows = 1 hour.
# When full, the OLDEST bulk rows are dropped and counted.
CSC14_BUFFER_BULK_ROWS=10800
# Events, humps, ACKs, link changes: kept in preference to telemetry.
CSC14_BUFFER_PRIORITY_ROWS=5000
# 1 = also store the complete decoded record as JSONB next to the typed
# columns and the original frame bytes (see docs/DESIGN.md, storage).
CSC14_STORE_DECODED_JSON=1

# --- Grafana --------------------------------------------------------------
CSC14_GRAFANA_HOST=127.0.0.1
CSC14_GRAFANA_PORT=3000
CSC14_GRAFANA_ADMIN_PASSWORD=
# true = anyone who can reach the port sees the dashboard read-only
CSC14_GRAFANA_ANONYMOUS=true
